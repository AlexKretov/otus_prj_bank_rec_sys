# Шаблон переменных окружения. Скопируйте в .env и подставьте свои значения:
#     cp .env.example .env
# Файл .env в репозиторий не коммитится (см. .gitignore).

# --- Kaggle API: загрузка датасета (loader.ipynb) ---
# Токен создаётся на Kaggle: Settings → API → Create New Token (скачается kaggle.json).
# Можно либо положить его в ~/.kaggle/kaggle.json, либо указать username/key здесь.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Соревнование, из которого берётся train_ver2.csv.
KAGGLE_COMPETITION=santander-product-recommendation
# Каталог, куда сохраняется датасет.
DATA_DIR=data
# 1 — перекачать датасет, даже если файл уже существует.
FORCE_DOWNLOAD=0
# 1 — посчитать число строк после загрузки (полный проход по файлу ~2.3 ГБ, несколько минут).
COUNT_ROWS=1

# --- MLflow: логирование обучения (modeling.ipynb) ---
# Адрес локального tracking-сервера (см. раздел «Запуск MLflow» в README.md).
MLFLOW_TRACKING_HOST=127.0.0.1
MLFLOW_TRACKING_PORT=5000

# --- Микросервис app1.py (опционально) ---
# Каталог с артефактами обучения и уровень логирования сервиса.
# ARTIFACTS_DIR=fastapi
# LOG_LEVEL=INFO
# Порт uvicorn внутри контейнера/процесса и порт хоста (compose).
# THE_PORT=8079
# VM_PORT=8079
# Число потоков пула синхронных эндпоинтов (меньше потоков — меньше
# «карусель» GIL при CPU-bound /predict; по умолчанию 10).
# THREAD_POOL_TOKENS=10

# --- Мониторинг: docker compose (опционально) ---
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_USER=admin
# Смените пароль Grafana для любой нелокальной установки.
# GRAFANA_PASS=admin

# --- Нагрузочный тест test.ipynb (опционально) ---
# LOAD_TEST_URL=http://localhost:8079/predict
# LOAD_TEST_WORKERS=50
# LOAD_TEST_MAX_TIME=50
# LOAD_TEST_SAMPLES=100
# LOAD_TEST_P95_SLO_MS=5000
# LOAD_TEST_MIN_SUCCESS_RATE=99.0
